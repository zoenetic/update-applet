{
  "id": "io.github.zoenetic.CosmicAppletUpdates",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "base": "com.system76.Cosmic.BaseApp",
  "base-version": "stable",
  "command": "cosmic-applet-updates",
  "finish-args": [
    "--socket=wayland",
    "--share=ipc",
    "--device=dri",
    "--filesystem=xdg-config/cosmic:rw",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--talk-name=com.system76.CosmicSettingsDaemon.*",
    "--system-talk-name=org.freedesktop.PackageKit",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/cosmic-applet-updates/cargo"
    }
  },
  "modules": [
    {
      "name": "cosmic-applet-updates",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --locked --verbose",
        "install -Dm0755 target/release/cosmic-applet-updates /app/bin/cosmic-applet-updates",
        "install -Dm0644 data/io.github.zoenetic.CosmicAppletUpdates.desktop /app/share/applications/io.github.zoenetic.CosmicAppletUpdates.desktop",
        "install -Dm0644 data/io.github.zoenetic.CosmicAppletUpdates.Settings.desktop /app/share/applications/io.github.zoenetic.CosmicAppletUpdates.Settings.desktop",
        "install -Dm0644 data/io.github.zoenetic.CosmicAppletUpdates.metainfo.xml /app/share/metainfo/io.github.zoenetic.CosmicAppletUpdates.metainfo.xml",
        "install -Dm0644 data/icons/scalable/apps/io.github.zoenetic.CosmicAppletUpdates-symbolic.svg /app/share/icons/hicolor/scalable/apps/io.github.zoenetic.CosmicAppletUpdates-symbolic.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": ["target", ".git", "vendor", ".flatpak-builder", "flatpak/build", "flatpak/repo"]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
